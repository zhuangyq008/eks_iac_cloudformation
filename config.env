#!/usr/bin/env bash
# =============================================================================
#  EKS + Nacos 交付配置  —  这是唯一需要修改的文件
#  所有脚本都会 source 本文件；CloudFormation 参数由脚本据此生成。
#
#  注意：随包附带的是交付方演练环境的【示例值】，部署前请替换成你自己的环境。
#    【必改】 每个环境都必须替换        【生产】 生产环境必须收紧
#  逐项说明见 README.md 第 3 节「网络配置向导」与「配置替换清单」。
# =============================================================================

# ---------- 基础 ----------
AWS_REGION="ap-southeast-1"          # 【必改】目标区域
# AWS_PROFILE=""                       # 留空使用当前默认凭证 / SSO 会话
PROJECT="sharetronic"                  # 【必改】资源命名前缀 + 成本分摊标签
ENVIRONMENT="test"                     # 【必改】test | staging | prod

# ---------- 网络（客户已创建，仅填 ID，不创建 VPC/子网） ----------
# 【必改】以下 VPC / 子网 ID 为示例值。无需手填：./scripts/01-preflight.sh 发现它们在你的账号里
# 不存在时，会自动进入网络配置向导，让你从列表中选择 VPC 与公有 / 私有子网并写回本文件。
VPC_ID="vpc-EXAMPLE00000000000"
# 公有子网：给 internet-facing ALB 和 NAT 网关用
PUBLIC_SUBNET_IDS="subnet-EXAMPLEPUBLIC0001,subnet-EXAMPLEPUBLIC0002"
# 私有子网：EKS 控制面 ENI、工作节点、Nacos EC2、RDS 都放这里
PRIVATE_SUBNET_IDS="subnet-EXAMPLEPRIVATE001,subnet-EXAMPLEPRIVATE002"
# 私有子网关联的路由表。留空 = 脚本按私有子网自动反查（含 main 路由表回退），推荐留空。
PRIVATE_ROUTE_TABLE_IDS=""

# NAT 网关策略：
#   auto  = 自动检测私有子网出网能力。缺失 / blackhole / 指向已删除 NAT 时，
#           自动清理残留默认路由、新建 NAT 网关（含 EIP）并修正相关私有路由表；
#           已有健康出口（活跃 NAT 或 TGW）则跳过，不动客户网络。
#   true  = 无条件创建 NAT 网关
#   false = 绝不创建（客户自行保证私有子网出网，或已配好 ECR/EKS/S3/STS VPC Endpoint）
CREATE_NAT_GATEWAY="auto"

# EKS 硬性要求 VPC 同时开启 enableDnsSupport 与 enableDnsHostnames，否则节点无法注册。
#   auto/true = 建集群前自动开启缺失的属性（推荐；这是启用属性，不影响已有资源）
#   false     = 只检查不修改，不满足则直接终止部署
FIX_VPC_DNS="auto"

# ---------- EKS 集群 ----------
CLUSTER_NAME="${PROJECT}-eks"
K8S_VERSION="1.36"                     # 2026-09 最新标准支持版本（patch 1.36.4）
# API Server 公共端点白名单（逗号分隔 CIDR）。生产务必收紧到客户办公网/跳板机出口 IP。
#   auto = 自动用「当前执行环境的出口 IP/32」。CloudShell 出口 IP 不固定，测试期用 auto 最省事；
#          若之后 IP 轮换导致 kubectl 连不上，执行 ./scripts/allow-my-ip.sh 追加即可。
#   生产交付请改成客户办公网出口段，例如 "203.0.113.0/24,198.51.100.10/32"
API_PUBLIC_ACCESS_CIDRS="auto"         # 【生产】改成办公网 / VPN 出口段
SERVICE_IPV4_CIDR="172.20.0.0/16"      # 不能与你的 VPC CIDR / 对等 / 专线网段重叠
ENABLE_SECRETS_ENCRYPTION="true"       # 新建 KMS key 做 etcd secrets 信封加密
# 额外授予 cluster-admin 的 IAM 角色 ARN（留空跳过）。
# 部署者本身已通过 BootstrapClusterCreatorAdminPermissions 自动获得 admin，
# 此处填**其他**角色（例如 CI/CD 角色、运维组角色），否则会与自动创建的条目冲突。
ADMIN_PRINCIPAL_ARN=""
# 当 kubectl 连不上 API Server 且判定是「当前出口 IP 不在白名单」时的处理方式：
#   auto/true = 自动把当前出口 IP/32 追加进白名单（只追加、绝不替换，不会踢掉别人）
#   false     = 只做诊断并给出修复命令，不改集群
# CloudShell 出口 IP 会轮换，测试期建议 auto；生产交付建议 false，由运维显式授权。
FIX_API_WHITELIST="auto"               # 【生产】改成 false

# ---------- 工作节点（托管节点组，x86） ----------
NODEGROUP_NAME="ng-general"
NODE_AMI_TYPE="AL2023_x86_64_STANDARD"
NODE_INSTANCE_TYPES="m7i.large,m7i.xlarge"
NODE_CAPACITY_TYPE="ON_DEMAND"         # ON_DEMAND | SPOT
NODE_DESIRED_SIZE="2"
NODE_MIN_SIZE="2"
NODE_MAX_SIZE="6"
NODE_VOLUME_SIZE="80"                  # GiB, gp3, 加密

# ---------- Addon / 控制器 ----------
INSTALL_LB_CONTROLLER="true"           # AWS Load Balancer Controller (Helm)
INSTALL_CLUSTER_AUTOSCALER="true"      # Cluster Autoscaler (Helm)，对接托管节点组 ASG
SET_GP3_DEFAULT_SC="true"              # gp3 设为默认 StorageClass，gp2 取消默认
# aws-load-balancer-controller: chart 3.5.0 == controller v3.5.0（当前最新稳定）
# 需要 2.x 线时改成 1.17.1（== controller v2.17.1），IAM 策略两条线完全一致，无需改动
LB_CONTROLLER_CHART_VERSION="3.5.0"
# cluster-autoscaler: chart 9.59.0 == CA 1.35.0。CA 对 K8s 版本容忍 ±1 个 minor，
# 1.36 的 CA 镜像发布后可用 CLUSTER_AUTOSCALER_IMAGE_TAG 覆盖。
CLUSTER_AUTOSCALER_CHART_VERSION="9.59.0"
CLUSTER_AUTOSCALER_IMAGE_TAG=""        # 留空用 chart 默认

# ---------- Nacos（独立 EC2，Graviton） ----------
# 是否部署 Nacos（含 EC2 + RDS MySQL + 内网 NLB + Secrets Manager）。
#   true  = 部署（02-deploy 阶段 5、03 下发 nacos-config、04 做 Nacos 冒烟与 RDS 断言）
#   false = 完全跳过，只交付 EKS。客户已有 Nacos / 或只想先验 EKS 时用这个。
# 注：即使为 false，./scripts/02-deploy.sh nacos 显式指定阶段仍会部署（显式意图优先）。
#     99-destroy.sh 不受此开关影响，始终会尝试清理 Nacos 相关资源。
INSTALL_NACOS="true"

NACOS_INSTANCE_TYPE="m7g.large"
NACOS_VERSION="2.3.2"                  # 客户指定版本
# 安装包下载前缀；客户环境访问不了 GitHub 时改成内部 S3/制品库前缀
NACOS_DOWNLOAD_BASE_URL="https://github.com/alibaba/nacos/releases/download"
NACOS_ROOT_VOLUME_SIZE="50"
NACOS_JVM_XMX="2g"
# 【必改】除 EKS 节点外，还允许哪些 CIDR 访问 Nacos 8848/9848（逗号分隔，留空则只允许 EKS）。
# 示例值 10.10.0.0/16 是演练 VPC 的网段，通常改成你的 VPC CIDR。
NACOS_EXTRA_CLIENT_CIDRS="10.10.0.0/16"
NACOS_ENABLE_CLOUDWATCH_LOGS="true"
# SSH 密钥对名称；留空则只能用 SSM Session Manager 登录（推荐留空）
NACOS_KEY_NAME=""

# ---------- Nacos 后端 RDS MySQL ----------
NACOS_DB_INSTANCE_CLASS="db.t4g.medium"
NACOS_DB_ENGINE_VERSION="8.0"          # RDS 自动选该大版本下的默认小版本（当前 8.0.42）
NACOS_DB_PARAMETER_GROUP_FAMILY="mysql8.0"   # 必须与上面大版本对应
NACOS_DB_ALLOCATED_STORAGE="50"
NACOS_DB_MULTI_AZ="false"              # 【生产】改成 true
NACOS_DB_BACKUP_RETENTION="7"
NACOS_DB_DELETION_PROTECTION="false"   # 【生产】改成 true

# ---------- 扩展：Graviton 节点组（可选，由 ./scripts/55-arm-nodegroup.sh 单独部署/删除） ----------
# 与 x86 节点组并存的 arm64 托管节点组，Cluster Autoscaler 自动发现、一起管理。
# 默认带 taint，只有声明了容忍的 Pod 才会调度上来；接入前应用镜像必须包含 linux/arm64。
ARM_NODEGROUP_NAME="ng-arm64"
ARM_NODE_INSTANCE_TYPES="m8g.large,m7g.large"    # 必须 arm64 且同规格（CAS 按同一规格估算）；脚本校验各 AZ 供给
ARM_NODE_CAPACITY_TYPE="ON_DEMAND"     # ON_DEMAND | SPOT
ARM_NODE_DESIRED_SIZE="1"
ARM_NODE_MIN_SIZE="0"                  # 0 = 允许 CAS 缩到 0 台（脚本会给 ASG 打从 0 扩容所需的标签）
ARM_NODE_MAX_SIZE="4"
ARM_NODE_SUBNET_IDS=""                 # 留空 = 复用 x86 节点组的子网
ARM_NODE_TAINT="true"                  # true = 节点带 arch=arm64:NoSchedule；镜像全部多架构后可改 false
ARM_TAINT_KEY="arch"
ARM_TAINT_VALUE="arm64"
# 集群内检查在哪执行：auto = 本机 kubectl 连得上就本机，否则经跳板机 SSM；local | bastion
ARM_KUBE_VIA="auto"

# ---------- 扩展：跳板 / 构建机（可选，由 ./scripts/50-bastion.sh 单独部署/删除） ----------
# 公有子网里的一台 x86 EC2：Jenkins 通过 SSH 登录，上传 JAR 后在本机 docker 构建镜像并推送 ECR；
# 经 EKS 私有端点访问集群（kubectl）与节点；支持 SSM 登录；实例角色可读写账号内所有 S3 桶。
# 需要 EKS 集群已存在；不参与 02-deploy / 99-destroy。
BASTION_INSTANCE_TYPE="m7i.large"      # x86_64（与 EKS x86 节点一致），AMI 自动按架构解析
BASTION_SUBNET_ID=""                   # 留空 = PUBLIC_SUBNET_IDS 的第一个
# SSH(22) 白名单，逗号分隔。auto = 当前出口 IP/32（CloudShell 会轮换）。
# 下方 JENKINS_EGRESS_CIDRS 会自动并入，两者合计最多 5 个 CIDR。生产请填办公网出口段。
BASTION_SSH_CIDRS="auto"               # 【生产】改成办公网出口段
BASTION_ROOT_VOLUME_SIZE="100"         # GiB, gp3, 加密（docker 镜像与构建缓存都在根卷上）
BASTION_ALLOCATE_EIP="true"            # 绑定弹性 IP：Jenkins 连接的地址停机重启后不变
BASTION_EKS_ACCESS="admin"             # admin = 机上 kubectl 有集群管理员权限；none = 不授权
BASTION_S3_ALLOW_DELETE="false"        # true = 额外授予删除 S3 对象权限（默认只读写不删）

# ---------- 扩展：外部 Jenkins CI/CD（可选，由 ./scripts/60-ci-setup.sh 单独部署/删除） ----------
# 给不在 AWS 上的 Jenkins 用。部署到 EKS 用 K8s ServiceAccount token 的 kubeconfig（只有下面命名空间的权限），
# 推镜像到 ECR 二选一（CI_ECR_AUTH）：
#   accesskey     IAM 用户静态 AK/SK，只能推拉 ${PROJECT}/* 仓库；配置最简单
#   rolesanywhere X.509 证书换 1 小时临时凭证（Jenkins 自动换，无需人工），没有长期密钥，安全要求高时用
# 详见 docs/jenkins-cicd.md
# 【必改】Jenkins 访问 AWS 的公网出口 IP/网段（逗号分隔）。会追加进 EKS 公共端点白名单，
# accesskey 模式下同时作为访问密钥的来源 IP 限制；50-bastion.sh 会把它并入跳板机 SSH 白名单
JENKINS_EGRESS_CIDRS=""
CI_ECR_AUTH="accesskey"                # accesskey | rolesanywhere
CI_KEY_LOCK_SOURCE_IP="true"           # accesskey：密钥只能从 JENKINS_EGRESS_CIDRS 使用（泄露后别处用不了）
CI_NAMESPACES="app"                    # Jenkins 可以部署的命名空间（逗号分隔），不存在会自动创建
CI_SA_NAME="jenkins-deployer"          # 每个命名空间里的 ServiceAccount 名
# 需要预建的 ECR 仓库（逗号分隔，自动加前缀 ${PROJECT}/）。Jenkins 只能推 ${PROJECT}/* 下的仓库
CI_ECR_REPOSITORIES="demo-app"
CI_CERT_CN="${PROJECT}-${ENVIRONMENT}-jenkins"   # rolesanywhere：客户端证书 CN，IAM 角色只信任这个 CN
CI_CERT_DAYS="365"                     # rolesanywhere：客户端证书有效期（天），到期前用 rotate-cert 换发
CI_CA_DAYS="3650"                      # rolesanywhere：自建 CA 有效期（天）。已有企业 PKI 时见文档「使用自有 CA」
CI_SIGNING_HELPER_VERSION="1.7.0"      # rolesanywhere：aws_signing_helper 版本（verify 子命令本地使用）

# =============================================================================
#  以下为派生变量，一般不需要改
# =============================================================================
STACK_NETWORK="${PROJECT}-${ENVIRONMENT}-network-prereq"
STACK_CLUSTER="${PROJECT}-${ENVIRONMENT}-eks-cluster"
STACK_NODEGROUP="${PROJECT}-${ENVIRONMENT}-eks-nodegroup"
STACK_NODEGROUP_ARM="${PROJECT}-${ENVIRONMENT}-eks-nodegroup-arm64"
STACK_ADDONS="${PROJECT}-${ENVIRONMENT}-eks-addons"
STACK_NACOS="${PROJECT}-${ENVIRONMENT}-nacos"
STACK_BASTION="${PROJECT}-${ENVIRONMENT}-bastion"
STACK_CI="${PROJECT}-${ENVIRONMENT}-ci-ecr"
